{
  "name": "codescan",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first code scanning desktop tool (self-built AST rule engine).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @codescan/desktop dev",
    "build": "pnpm --filter @codescan/desktop build",
    "typecheck": "pnpm --filter @codescan/desktop typecheck",
    "test": "pnpm --filter @codescan/desktop test",
    "test:rust": "cargo test --workspace",
    "check:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "tauri": "pnpm --filter @codescan/desktop tauri"
  }
}
