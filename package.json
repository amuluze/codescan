{
  "name": "codescan-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "pnpm --dir codescan install",
    "dev": "pnpm --dir codescan run dev",
    "dev:app": "pnpm --dir codescan run dev:app",
    "build": "pnpm --dir codescan run build",
    "typecheck": "pnpm --dir codescan run typecheck",
    "test": "pnpm --dir codescan run test",
    "test:cli": "pnpm --dir codescan run test:cli",
    "test:rust": "pnpm --dir codescan run test:rust",
    "check:rust": "pnpm --dir codescan run check:rust",
    "check": "pnpm --dir codescan run check",
    "build:app": "pnpm --dir codescan run build:app",
    "build:dmg": "pnpm --dir codescan run build:dmg",
    "generate:notices": "pnpm --dir codescan run generate:notices",
    "check:notices": "pnpm --dir codescan run check:notices",
    "generate:release-config": "pnpm --dir codescan run generate:release-config",
    "release:signing-check": "pnpm --dir codescan run release:signing-check",
    "release:latest-json": "pnpm --dir codescan run release:latest-json",
    "tauri": "pnpm --dir codescan run tauri",
    "clean": "pnpm --dir codescan run clean",
    "scan": "pnpm --dir codescan run scan",
    "scan:sarif": "pnpm --dir codescan run scan:sarif"
  }
}
