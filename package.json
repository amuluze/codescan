{
  "name": "codescan",
  "private": true,
  "version": "1.0.0",
  "description": "Local-first code scanning desktop tool (self-built AST rule engine).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @codescan/desktop dev",
    "build": "pnpm --filter @codescan/desktop build",
    "typecheck": "pnpm --filter @codescan/desktop typecheck",
    "test": "pnpm --filter @codescan/desktop test",
    "test:cli": "cargo test -p codescan-cli",
    "test:rust": "cargo test --workspace",
    "check:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm check:rust && pnpm test:rust",
    "build:app": "pnpm --filter @codescan/desktop tauri build --target aarch64-apple-darwin --bundles app",
    "build:dmg": "pnpm run generate:release-config && pnpm --filter @codescan/desktop tauri build --target aarch64-apple-darwin --config src-tauri/tauri.ci.conf.json",
    "generate:release-config": "node scripts/generate-release-config.mjs",
    "release:signing-check": "bash scripts/release-signing-check.sh",
    "release:latest-json": "node scripts/generate-latest-json.mjs",
    "tauri": "pnpm --filter @codescan/desktop tauri"
  }
}
